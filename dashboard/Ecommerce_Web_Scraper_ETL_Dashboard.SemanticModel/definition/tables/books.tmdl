table books
	lineageTag: 4138013f-0342-4bd2-9a7b-1ee05bcc8b6e

	measure 'Total Products' = COUNTROWS(books)
		formatString: #,##0
		displayFolder: Core Metrics
		lineageTag: 1424e842-2c46-4d64-b2cf-c9add7e96ef1

	measure 'Average Price' = AVERAGE(books[price])
		formatString: £#,##0.00
		displayFolder: Core Metrics
		lineageTag: cca50642-51b6-4922-98a1-97a8317906fa

	measure 'Average Rating' = AVERAGE(books[rating])
		formatString: 0.00
		displayFolder: Core Metrics
		lineageTag: 0b56c4df-f4c1-4b08-96b8-d1270c34fa29

	measure 'Average Stock' = AVERAGE(books[availability_count])
		formatString: 0.00
		displayFolder: Core Metrics
		lineageTag: c738e01b-d01b-4933-9745-7f1af165e2f8

	measure 'Total Stock' = SUM(books[availability_count])
		formatString: #,##0
		displayFolder: Core Metrics
		lineageTag: 40276b9b-81ba-4ce5-a4ee-cf06cd3aac46

	measure 'Low Stock Products' =
			CALCULATE(
			    COUNTROWS(books),
			    books[availability_count] <= 5
			)
		formatString: #,##0
		displayFolder: Inventory
		lineageTag: 1aa2ac2c-834d-4120-825c-7f66a45bb447

	measure 'Low Stock %' =
			DIVIDE(
			    [Low Stock Products],
			    [Total Products]
			)
		formatString: 0%
		displayFolder: Inventory
		lineageTag: fe4c4b1e-0de6-44b3-b764-b6f8c68a0a08

	measure 'Average Price Incl Tax' = AVERAGE(books[price_incl_tax])
		formatString: £#,##0.00
		displayFolder: Pricing
		lineageTag: 426a0463-499e-4bf3-9b42-6118988162cb

	measure 'Average Price Excl Tax' = AVERAGE(books[price_excl_tax])
		formatString: £#,##0.00
		displayFolder: Pricing
		lineageTag: b4088221-e9c5-47c5-8084-747b6e036e40

	measure 'Total Categories' = DISTINCTCOUNT(books[category])
		formatString: #,##0
		displayFolder: Core Metrics
		lineageTag: 773a225b-8cb4-4c68-8710-6b65a6bcee71

	measure 'Five Star Products' =
			CALCULATE(
			    COUNTROWS(books),
			    books[rating] = 5
			)
		formatString: #,##0
		displayFolder: Ratings
		lineageTag: f84e815b-f89c-4edd-ad4c-f01d7659741b

	measure 'One Star Products' =
			CALCULATE(
			    COUNTROWS(books),
			    books[rating] = 1
			)
		formatString: #,##0
		displayFolder: Ratings
		lineageTag: 223a8377-1df4-4190-8d5c-c42b1c97f110

	measure 'Highest Price' = MAX(books[price])
		formatString: £#,##0.00
		displayFolder: Pricing
		lineageTag: 8dfa3ff7-4b9e-4797-8cca-d81d462d618c

