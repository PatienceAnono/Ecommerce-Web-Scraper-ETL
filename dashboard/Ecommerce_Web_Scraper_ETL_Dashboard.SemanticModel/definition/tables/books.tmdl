	column scraped_at
		dataType: dateTime
		formatString: General Date
		lineageTag: 7a2518ff-c1d1-4edf-8d45-4d6717522185
		summarizeBy: none
		sourceColumn: scraped_at

		variation Variation
			isDefault
			relationship: 41d26361-362b-4e4b-b9b0-38accc9c2d1c
			defaultHierarchy: LocalDateTable_3706de3e-5b6c-4088-b173-79eea055d9bb.'Date Hierarchy'

		annotation SummarizationSetBy = Automatic

	column 'Price Band' =
			SWITCH(
			    TRUE(),
			    books[price] < 20, "Under £20",
			    books[price] < 40, "£20–£39.99",
			    books[price] < 50, "£40–£49.99",
			    "£50+"
			)
		dataType: string
		displayFolder: Attributes
		lineageTag: 0a077783-c7e1-45d6-8f9c-984e669f377e
		sortByColumn: 'Price Band Sort'

	column 'Stock Status' =
			SWITCH(
			    TRUE(),
			    books[availability_count] <= 5, "Low Stock",
			    books[availability_count] <= 10, "Moderate Stock",
			    "Healthy Stock"
			)
		dataType: string
		displayFolder: Attributes
		lineageTag: d7e01ec9-b5c7-4487-a0b0-0db5c6c672d4

	column 'Rating Label' = FORMAT(books[rating], "0") & " Stars"
		dataType: string
		displayFolder: Attributes
		lineageTag: 9d4d4cd4-629e-4c62-a3e8-412e3f7a73fd

	column 'Price Band Sort' =
			SWITCH(
			    TRUE(),
			    books[price] < 20, 1,
			    books[price] < 40, 2,
			    books[price] < 50, 3,
			    4
			)
		dataType: int64
		isHidden
		displayFolder: Attributes
		lineageTag: 0a696e33-70da-40a0-8d1e-8f497f557854

